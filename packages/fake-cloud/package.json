{
  "name": "@next-evolve/fake-cloud",
  "version": "0.0.0",
  "private": true,
  "description": "Protocol-level mock of Evolve Cloud for SDK tests. Implements the wire protocol only: no stats, no dashboard, no AI.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fake-cloud": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@next-evolve/protocol": "workspace:*"
  }
}
