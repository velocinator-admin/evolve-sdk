{
  "name": "@next-evolve/protocol",
  "version": "1.3.0",
  "description": "Wire protocol for Evolve: bundle, signature and aggregate schemas shared by next-evolve and Evolve Cloud.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "fixtures"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "unrun scripts/write-fixtures.ts && biome format --write fixtures"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "protocol-1.0.0": "npm:@next-evolve/protocol@1.0.0",
    "protocol-1.2.0": "npm:@next-evolve/protocol@1.2.0"
  }
}
