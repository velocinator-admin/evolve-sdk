exports[`wrap > --yes writes the sibling schema file and the <Optimizable> usage, then runs tsc 1`] = `
"// Evolve regions for ./hero.tsx, generated by \`npx next-evolve wrap\`.
// A schema lists the props Evolve may change: tighten limits, add .meta({ label: "…" })
// or .meta({ locked: true }), or delete a line to keep a prop fixed. Server-only.
import { optimizable } from "next-evolve";
import { z } from "zod";
import { Hero, Banner } from "./hero";

export const heroSchema = z.object({
  title: z.string().max(80),
  cta: z.string().max(40),
});
// Kept as you pass them (not editable): href (a link or asset URL).

export const OptimizableHero = optimizable(Hero, heroSchema);

export const bannerSchema = z.object({
  children: z.string().max(120),
  tone: z.enum(["info", "warn"]).optional(),
});

export const OptimizableBanner = optimizable(Banner, bannerSchema);
"
`;

exports[`wrap > --yes writes the sibling schema file and the <Optimizable> usage, then runs tsc 2`] = `
"import type { Metadata } from "next";
import { Optimizable } from "next-evolve";
import { OptimizableHero, OptimizableBanner } from "../components/hero.evolve";

export const metadata: Metadata = { title: "Home" };

export default function Home() {
  return (
    <main>
      <Optimizable
        id="home-hero"
        component={OptimizableHero}
        props={{ title: "Ship faster", cta: "Start free", href: "/signup" }}
      />
      <Optimizable
        id="home-banner"
        component={OptimizableBanner}
        props={{ tone: "info", children: "Launch week" }}
      />
    </main>
  );
}
"
`;

exports[`wrap > local components of the page get their schema in the page 1`] = `
"import { Optimizable, optimizable } from "next-evolve";
import { z } from "zod";

function Intro({ heading }: { heading: string }) {
  return <h2>{heading}</h2>;
}

const introSchema = z.object({
  heading: z.string().max(80),
});
const OptimizableIntro = optimizable(Intro, introSchema);

export default function Home() {
  return <Optimizable id="home-intro" component={OptimizableIntro} props={{ heading: "Why" }} />;
}
"
`;
